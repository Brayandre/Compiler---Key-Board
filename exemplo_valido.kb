computador_iniciar
SETCAPS numint contador --> 0 $
CAPS numint limite $
SET limite --> 10 $
SHIFT (contador < limite) {
    prt_scr ("valor: " # contador) $
    SET contador --> contador + 1 $
}
ALT (contador == limite) {
    prt_scr ("terminou") $
} TAB {
    prt_scr ("nao chegou") $
}
ALTGR (CAPS numint i $ : i < 5 $ : i + # + #) {
    prt_scr ("i = " # i) $
}
computador_encerrar $
